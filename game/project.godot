; Engine configuration file.
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Slopitect"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

; The microphone, for hold-to-talk (voice.gd). Android still asks you before
; the app can use it.
driver/enable_input=true
; Speech out through the headset's text-to-speech engine (voice.gd).
general/text_to_speech=true

[debug]

settings/stdout/verbose_stdout=true

[rendering]

; OpenGL ES 3 renderer. The Quest 1 has GLES 3.2 with GL_OVR_multiview2,
; which this renderer uses to draw both eyes in one pass.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
; 2 = local floor: the floor is at the player's real floor height.
openxr/reference_space=2
shaders/enabled=true
